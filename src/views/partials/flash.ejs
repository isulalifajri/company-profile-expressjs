<% if (flash.success) { %>

    <div
        class="alert alert-success alert-dismissible fade show"
        role="alert">

        <strong>Success!</strong>
        <%= flash.success %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>

<% } %>


<% if (flash.error) { %>

    <div
        class="alert alert-danger alert-dismissible fade show"
        role="alert">

        <strong>Error!</strong>
        <%= flash.error %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>

    </div>

<% } %>