<div class="container py-5">

    <h1>Contact Us</h1>

    <form action="/contact" method="POST">

        <div class="mb-3">

            <label class="form-label">

                Name

            </label>

            <input
                type="text"
                class="form-control"
                name="name">

        </div>

        <div class="mb-3">

            <label class="form-label">

                Email

            </label>

            <input
                type="email"
                class="form-control"
                name="email">

        </div>

        <div class="mb-3">

            <label class="form-label">

                Message

            </label>

            <textarea
                class="form-control"
                rows="5"
                name="message"></textarea>

        </div>

        <button
            class="btn btn-primary">

            Send Message

        </button>

    </form>

</div>