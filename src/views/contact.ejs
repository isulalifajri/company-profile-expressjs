<div class="container py-5">

    <h1>Contact Us</h1>

    <% if (flash.success) { %>

        <div class="alert alert-success">
            <%= flash.success %>
        </div>

    <% } %>

    <% if (flash.error) { %>

        <div class="alert alert-danger">
            <%= flash.error %>
        </div>

    <% } %>

    <form action="/contact" method="POST">

        <div class="mb-3">

            <label class="form-label">

                Name

            </label>

            <input
                type="text"
                class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                name="name"
                value="<%= old.name || '' %>">

            <% if (errors.name) { %>
                <div class="invalid-feedback">
                    <%= errors.name.msg %>
                </div>
            <% } %>

        </div>

        <div class="mb-3">

            <label class="form-label">

                Email

            </label>

            <input
                type="email"
                class="form-control <%= errors.email ? 'is-invalid' : '' %>"
                name="email"
                value="<%= old.email || '' %>">

            <% if (errors.email) { %>
                <div class="invalid-feedback">
                    <%= errors.email.msg %>
                </div>
            <% } %>

        </div>

        <div class="mb-3">

            <label class="form-label">

                Message

            </label>

            <textarea
                class="form-control <%= errors.message ? 'is-invalid' : '' %>"
                rows="5"
                name="message"><%= old.message || '' %></textarea>

            <% if (errors.message) { %>
                <div class="invalid-feedback">
                    <%= errors.message.msg %>
                </div>
            <% } %>

        </div>

        <button
            class="btn btn-primary">

            Send Message

        </button>

    </form>

</div>