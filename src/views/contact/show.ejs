<div class="container py-4">

    <%- include("../partials/flash") %>

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Contact Detail</h1>

            <p class="text-muted mb-0">
                Detail pesan yang masuk.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a
                href="/contact/messages/<%= contact.id %>/edit"
                class="btn btn-primary">

                Edit

            </a>

             <form
                action="/contact/messages/<%= contact.id %>/delete"
                method="POST"
                onsubmit="return confirm('Yakin ingin menghapus contact ini?');">

                <button
                    type="submit"
                    class="btn btn-danger">

                    Delete

                </button>

            </form>

            <a
                href="/contact/messages"
                class="btn btn-secondary">

                ← Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-3">

                <label class="fw-bold">
                    Name
                </label>

                <div>
                    <%= contact.name %>
                </div>

            </div>


            <div class="mb-3">

                <label class="fw-bold">
                    Email
                </label>

                <div>
                    <%= contact.email %>
                </div>

            </div>


            <div class="mb-3">

                <label class="fw-bold">
                    Message
                </label>

                <div>
                    <%= contact.message %>
                </div>

            </div>


            <div class="mb-3">

                <label class="fw-bold">
                    Created At
                </label>

                <div>
                    <%= contact.created_at %>
                </div>

            </div>


            <div>

                <label class="fw-bold">
                    Updated At
                </label>

                <div>
                    <%= contact.updated_at %>
                </div>

            </div>

        </div>

    </div>

</div>